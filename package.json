{
  "name": "cutwise",
  "version": "1.0.0",
  "description": "Local-first video editor with browser-based MP4 export.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
